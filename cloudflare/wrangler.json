{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lansrry-loja",
  "main": "../dist/company/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/company/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "limits": {"cpu_ms": 100},
  "vars": {"APP_MODE": "production"},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
